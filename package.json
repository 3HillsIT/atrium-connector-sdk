{
  "name": "@atrium/connector-sdk",
  "version": "0.3.0",
  "private": true,
  "description": "SDK for authoring Atrium connectors and talking to the Atrium mediation broker without ever holding a raw credential.",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.6",
    "typescript": "^5.5.4"
  }
}
