{
  "name": "@3hillsit/atrium-connector-sdk",
  "version": "1.0.0",
  "description": "Build, check and sign Connectors for atrium. The handler never holds a credential: atrium's broker makes the calls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3HillsIT/atrium-connector-sdk.git"
  },
  "homepage": "https://github.com/3HillsIT/atrium-connector-sdk#readme",
  "bugs": {
    "url": "https://github.com/3HillsIT/atrium-connector-sdk/issues"
  },
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "atrium-connector": "bin/atrium-connector.ts"
  },
  "files": [
    "bin",
    "docs",
    "atrium-connector-docs.html",
    "src",
    "examples",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./artifact": {
      "types": "./src/artifact/index.ts",
      "default": "./src/artifact/index.ts"
    },
    "./build": {
      "types": "./src/build/index.ts",
      "default": "./src/build/index.ts"
    }
  },
  "scripts": {
    "prepack": "bun scripts/build-docs.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.1.6",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
